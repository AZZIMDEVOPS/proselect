SUPABASE_SERVICE_ROLE_KEY=

# ---- Email (Resend: https://resend.com/api-keys; verify proselectimports.com sending domain) ----
RESEND_API_KEY=
EMAIL_FROM="ProSelect <no-reply@proselectimports.com>"
# Comma-separated internal recipients for new RFQ / lead / partner application alerts
SALES_NOTIFY_EMAIL=kennahkent50@gmail.com,info@proselectimports.com

# ---- Spam protection: Cloudflare Turnstile (optional but recommended in production) ----
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

